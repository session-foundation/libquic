#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1

include /usr/share/dpkg/pkg-info.mk

# see FEATURE AREAS in dpkg-buildflags(1)
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
export DEB_CFLAGS_MAINT_APPEND  = -DNDEBUG
export DEB_CXXFLAGS_MAINT_APPEND  = -DNDEBUG
# package maintainers to append LDFLAGS
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed


%:
	dh $@ --buildsystem=cmake --parallel

override_dh_auto_configure:
	debian/gen-liboxen-quic-install.sh $(DEB_VERSION_UPSTREAM)
	dh_auto_configure -- \
		$(DEB_CMAKE_ARCH_OPTIONS) \
		-DBUILD_SHARED_LIBS=ON \
		-DLIBQUIC_VERSION_SO=ON \
		-DLIBQUIC_SPEEDTEST_PREFIX=quic-

override_dh_auto_test:
	./obj-$(DEB_BUILD_GNU_TYPE)/tests/alltests --log-level warning --no-ipv6 --disable-0rtt --colour-mode ansi

# ngtcp2's symbols file only records when each function first appeared, so
# ${shlibs:Depends} only asks for >= 1.1.0.  But the *_versioned calls pass the
# struct versions (NGTCP2_SETTINGS_VERSION, NGTCP2_CALLBACKS_VERSION, ...) of the
# headers we build against, and an older libngtcp2 that doesn't know those
# versions crashes, so depend on at least the ngtcp2 we built with.  (No error
# if it's missing: `clean` may run where the build-deps aren't installed.)
NGTCP2_VERSION := $(shell dpkg-query -W -f='$${source:Upstream-Version}' libngtcp2-dev 2>/dev/null)

override_dh_gencontrol:
	dh_gencontrol -- -Vngtcp2:Version=$(NGTCP2_VERSION)

# dh_make generated override targets
# This is example for Cmake (See https://bugs.debian.org/641051 )
#override_dh_auto_configure:
#	dh_auto_configure -- #	-DCMAKE_LIBRARY_PATH=$(DEB_HOST_MULTIARCH)

