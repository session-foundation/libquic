prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: liboxenquic-utils
Description: Address, IP and utility types from liboxenquic, without its libevent and ngtcp2 dependencies
Version: @PROJECT_VERSION@

Libs: -L${libdir} -loxenquic-utils
Requires: liboxenc
Cflags: -I${includedir}
